# OpenWeatherMap API key. Optional: when unset, the server falls back to the
# key provided with the challenge prompt (see src/services/geo.js).
# OPENWEATHER_API_KEY=your-openweathermap-api-key

# Server port (defaults to 8080)
# PORT=8080

# --- Firebase Realtime Database (optional) ---
# When FIREBASE_DATABASE_URL is set, users are stored in Firebase RTDB.
# When it is not set, an in-memory store is used so the app runs with zero setup.
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Credentials: either a service-account JSON string...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# ...or a path to a service-account file (standard Google env var):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
